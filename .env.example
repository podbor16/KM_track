# KM Track — шаблон переменных окружения
# Скопировать в .env и заполнить значения: cp .env.example .env

# База данных MySQL (внешний сервер)
DB_HOST=
DB_PORT=16171
DB_NAME=krasmarafon
DB_USER=
DB_PASSWORD=

# Администратор (страница /business-analytics)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Безопасность
SECRET_KEY=

# Siberman: секрет в адресе вебхука заявок, длинная случайная строка
SIBERMAN_WEBHOOK_SECRET=

# Письма с кодом входа: log (разработка) или smtp (прод, ящик noreply@krasmarafon.ru в Яндексе)
MAIL_BACKEND=log
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@krasmarafon.ru
SMTP_PASSWORD=
MAIL_FROM=Красмарафон <noreply@krasmarafon.ru>
# Локально: http://localhost:8000
PUBLIC_BASE_URL=https://results.krasmarafon.ru

# DataLens (бизнес-аналитика)
DATALENS_KEY_SECRET=
DATALENS_EMBEDS=

# CORS (через запятую, или * для всех)
CORS_ORIGINS=https://results.krasmarafon.ru,https://krasmarafon.ru

# Режим запуска
DEBUG=False
HOST=127.0.0.1
PORT=8000
